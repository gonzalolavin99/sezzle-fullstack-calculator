# Served by the official nginx image, which replaces ${BACKEND_URL} from the environment at startup
# (files in /etc/nginx/templates/ are rendered into /etc/nginx/conf.d/).
server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;
    # client_max_body_size stays at nginx's 1 MB default on purpose: it is above the backend's 64 KiB limit, so an
    # oversized calculate request reaches the backend and gets its JSON INVALID_REQUEST error, not an nginx page.

    # nginx gotcha: a location with its own add_header drops every add_header from this level,
    # so the locations below that set Cache-Control repeat these two lines.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin API: the browser calls /api/... here and nginx forwards it, so no CORS is needed.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite puts a content hash in every asset name, so assets can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    # index.html is checked on every visit, so a new deployment is picked up at once.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri /index.html;
    }
}
